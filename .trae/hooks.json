{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "toolkit\\python.exe .trae\\hooks\\session_start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|RunCommand|Shell|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "toolkit\\python.exe .trae\\hooks\\pre_tool_check.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "toolkit\\python.exe .trae\\hooks\\post_tool_check.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "loop_limit": 3,
        "hooks": [
          {
            "type": "command",
            "command": "toolkit\\python.exe .trae\\hooks\\session_review.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
